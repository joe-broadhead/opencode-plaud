{
  "name": "@we-the-rebel-alliance/plaud-plugin",
  "version": "0.0.1",
  "description": "Plaud voice recordings: an events source, a recent-recordings snapshot and a local export through Plaud's MCP server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/plaud-plugin.git"
  },
  "homepage": "https://github.com/we-the-rebel-alliance/plaud-plugin#readme",
  "bugs": {
    "url": "https://github.com/we-the-rebel-alliance/plaud-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin-contract",
    "plaud"
  ],
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "plaud",
      "title": "Plaud",
      "summary": "Plaud voice recordings: list an account's recordings as events, read the newest as a list, and export one recording's audio, transcript or note to a local file. Reads only, plus one local export; Plaud's own MCP tools pass through.",
      "vendor": {
        "id": "plaud",
        "name": "Plaud",
        "domain": "plaud.ai"
      },
      "icons": [
        {
          "src": "assets/icon.svg",
          "type": "image/svg+xml"
        },
        {
          "src": "assets/icon-128.png",
          "type": "image/png"
        },
        {
          "src": "assets/icon-256.png",
          "type": "image/png"
        }
      ],
      "host": {
        "opencode": ">=2.4.1 <2.5.0",
        "tested": [
          "2.4.1"
        ]
      }
    },
    "accounts": {
      "via": "mcp",
      "profile": {
        "$ref": "#/options/properties/accounts/additionalProperties"
      },
      "owner": "plaud"
    },
    "options": {
      "type": "object",
      "properties": {
        "access": {
          "type": "string",
          "enum": [
            "all",
            "ask-changes",
            "read-only"
          ],
          "default": "all",
          "description": "How much the plugin's methods may do. Reads run at every level; the export runs at all, asks at ask-changes and is refused at read-only."
        },
        "accounts": {
          "type": "object",
          "description": "One profile per account alias. Each alias signs in to its own Plaud MCP server, named plaud for default and plaud-<alias> otherwise.",
          "additionalProperties": {
            "type": "object",
            "properties": {},
            "additionalProperties": false,
            "description": "One Plaud account. It has no fields: OpenCode holds the sign-in for the alias's server."
          }
        },
        "allowUntestedHost": {
          "type": "boolean",
          "default": false,
          "description": "Start outside the tested OpenCode range instead of refusing with HOST_UNTESTED."
        },
        "url": {
          "type": "string",
          "default": "https://mcp.plaud.ai/mcp",
          "description": "The Plaud MCP endpoint every account's server uses. Change it only to reach Plaud through a proxy you run; plain http is accepted only on localhost."
        },
        "exportRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "default": [
            "~/Plaud"
          ],
          "description": "The folders an export may write in, absolute or starting with ~/. The first holds the default destination. A destination outside every root is refused."
        },
        "maxAudioBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736,
          "default": 2147483648,
          "description": "The largest audio file one export downloads, in bytes, up to 64 GiB. The default is 2 GiB."
        },
        "exportTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000,
          "default": 1800000,
          "description": "How long one export may take, in milliseconds, from 1 second to 24 hours. The default is 30 minutes."
        }
      },
      "additionalProperties": false
    },
    "methods": {
      "status": {
        "class": "read",
        "accounts": "none"
      },
      "probe": {
        "class": "read",
        "accounts": "optional",
        "operations": [
          "get_current_user"
        ]
      },
      "events_list": {
        "class": "read",
        "accounts": "optional",
        "operations": [
          "list_files"
        ]
      },
      "recent": {
        "class": "read",
        "accounts": "optional",
        "operations": [
          "list_files"
        ]
      },
      "plan_export": {
        "class": "read",
        "accounts": "optional",
        "plans": true
      },
      "export": {
        "class": "export",
        "accounts": "optional",
        "commits": "plan_export",
        "operations": [
          "get_file",
          "get_note",
          "get_transcript"
        ]
      },
      "mcp:get_current_user": {
        "class": "read"
      },
      "mcp:get_file": {
        "class": "read"
      },
      "mcp:get_note": {
        "class": "read"
      },
      "mcp:get_transcript": {
        "class": "read"
      },
      "mcp:list_files": {
        "class": "read"
      }
    },
    "sources": [
      {
        "id": "plaud.recordings",
        "kind": "events",
        "reads": "meeting",
        "method": "events_list",
        "input": {
          "source": "recordings"
        },
        "service": {
          "id": "plaud.recordings",
          "label": "Recordings"
        },
        "operations": [
          "list_files"
        ],
        "cadence": {
          "suggestMinutes": 15
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 262144
      },
      {
        "id": "plaud.recent",
        "kind": "snapshot",
        "output": "list",
        "method": "recent",
        "service": {
          "id": "plaud.recordings",
          "label": "Recordings"
        },
        "operations": [
          "list_files"
        ],
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 262144
      }
    ],
    "actions": [
      {
        "id": "plaud.export",
        "effect": "local",
        "preview": "plan_export",
        "commit": "export",
        "input": {
          "type": "object",
          "properties": {
            "recordingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "type": "string",
              "enum": [
                "audio",
                "transcript",
                "note"
              ]
            },
            "block": {
              "type": "string",
              "enum": [
                "transaction",
                "transaction_polish",
                "outline",
                "mark_memo"
              ]
            },
            "destination": {
              "type": "string"
            },
            "overwrite": {
              "type": "boolean"
            },
            "account": {
              "type": "string"
            }
          },
          "required": [
            "recordingId",
            "kind"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        }
      }
    ],
    "events": {}
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run --project unit",
    "test:host": "vitest run --project host",
    "test:pack": "vitest run --project pack",
    "fixtures": "node scripts/record-fixture.mjs",
    "docs": "plugin-kit docs",
    "docs:check": "plugin-kit docs --check",
    "check": "npm run typecheck && npm run bundle && npm test && npm run test:host && npm run test:pack && plugin-kit check && plugin-kit docs --check",
    "bundle": "npm run clean && node scripts/build.mjs"
  },
  "devDependencies": {
    "@opencode/client": "2.4.1",
    "@opencode/core": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/plugin-contract": "github:we-the-rebel-alliance/plugin-contract#v0.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
