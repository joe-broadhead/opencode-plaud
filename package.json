{
  "name": "@joe-broadhead/opencode-plaud",
  "version": "0.0.0",
  "description": "Unofficial OpenCode plugin for Plaud recordings",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-plaud.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-plaud#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-plaud/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plaud"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "plaud",
      "name": "Plaud",
      "domain": "plaud.ai"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tui.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "vitest run --project lint && node scripts/check-copies.mjs && node scripts/check-icons.mjs && node scripts/check-workflows.mjs && node scripts/check-forbidden.mjs",
    "test": "vitest run --project unit",
    "test:host": "node scripts/host-tests.mjs",
    "test:pack": "vitest run --project pack",
    "check": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:host && npm run test:pack",
    "check:upstream": "node scripts/check-upstream.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "24.19.2",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "jelly": {
    "title": "Plaud",
    "summary": "Your Plaud recordings, transcripts and notes.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "plaud.recent",
        "permission": "plaud_recent",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "plaud.events_list",
        "permission": "plaud_events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "plaud.list_files",
        "permission": "plaud_list_files",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "plaud.get_file",
        "permission": "plaud_get_file",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "plaud.get_note",
        "permission": "plaud_get_note",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "plaud.get_transcript",
        "permission": "plaud_get_transcript",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "plaud.get_current_user",
        "permission": "plaud_get_current_user",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "plaud.export",
        "permission": "plaud_export",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "opencode-plaud",
      "opencode-plaud-export",
      "opencode-plaud-digest"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "plaud",
        "label": "Plaud",
        "server": "plaud*",
        "account": {
          "option": "accounts",
          "label": "Account name",
          "description": "A short name for another Plaud account, such as work. Its server is plaud-<name>, listed in /connect as Plaud (<name>).",
          "placeholder": "work",
          "required": false,
          "reserved": [
            "default"
          ]
        }
      }
    ],
    "contributes": {
      "homeFeeds": [
        {
          "id": "plaud.recent",
          "label": "Recent Plaud recordings",
          "description": "Your newest recordings, by title, time and length.",
          "keywords": [
            "plaud",
            "recordings",
            "voice notes"
          ],
          "feed": {
            "title": "Recent recordings",
            "size": "m",
            "template": "list",
            "cadence": 1800,
            "mode": "looking",
            "preview": "desktop-only",
            "tools": [
              "plaud.recent"
            ],
            "script": "return await tools.plaud.recent({});"
          }
        }
      ],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "default": "all",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule."
        }
      ]
    }
  }
}
